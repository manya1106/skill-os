# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Redis cache (top-100 recs per user, target <200ms on hits)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL_SECONDS=14400
CACHE_TOP_N=100

# Hybrid blending defaults (overridable per request via query params)
DEFAULT_CF_WEIGHT=0.7
DEFAULT_TFIDF_WEIGHT=0.3

# Nightly retraining (APScheduler, 02:00 UTC)
RETRAIN_CRON_HOUR=2
RETRAIN_CRON_MINUTE=0
RETRAIN_MIN_INTERACTIONS=50
RETRAIN_SECRET=changemeplease
LOG_DIR=./logs
